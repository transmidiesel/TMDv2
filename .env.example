# =========================================================
# Plantilla de variables de entorno
# Copia este archivo a `.env` y rellena los valores reales
# =========================================================

# CurrencyAPI (obtén tu key en https://currencyapi.com/)
CURRENCY_API_KEY=tu_api_key_aqui

# Token secreto para el cron job (inventa uno largo y aleatorio)
CRON_TOKEN=tu_token_secreto_aqui

# Moneda base en la que se guardan los precios
MONEDA_BASE=USD

# Monedas a convertir (separadas por coma)
MONEDAS=COP,EUR,MXN